<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashCard.Pages.ViewDeckPage"
             Title="DeckView">

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">

        <!-- Header with add button -->
        <VerticalStackLayout>
            <HorizontalStackLayout Grid.Row="0"
                                  Spacing="10"
                                  Margin="0,0,0,10">
                <Entry x:Name="NewCardRectoEntry"
                       Placeholder="Recto de la carte."
                       HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>

                <Entry x:Name="NewCardVersoEntry"
                   Placeholder="Verso de la carte."
                   HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>

                <Button Text="Ajouter"
                        BackgroundColor="#2196F3"
                        Clicked="OnAddCardClicked"
                        TextColor="White" />

                <Button Text="▶ Jouer"
                        BackgroundColor="#4CAF50"
                        Clicked="OnPlayQuizClicked"
                        TextColor="White" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                       x:Name="CardsCollectionView"
                       SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="0,5"
                           Padding="10"
                           BorderColor="LightGray"
                           CornerRadius="8"
                           HasShadow="True">
                    <Grid ColumnDefinitions="*,Auto,Auto">

                        <!-- Card info -->
                        <StackLayout Grid.Column="0"
                                        VerticalOptions="Center">
                            <Label Text="{Binding Recto}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                            <Label Text="{Binding Verso}"
                                       FontSize="14"
                                       TextColor="Gray" />
                            <Label Text="{Binding CreatedDate, StringFormat='Créé le {0:dd/MM/yyyy}'}"
                                       FontSize="12"
                                       TextColor="LightGray" />
                        </StackLayout>

                            <!-- Edit button -->
                        <Button Grid.Column="1"
                                   Text="✏️"
                                   FontSize="20"
                                   BackgroundColor="Transparent"
                                   Clicked="OnEditCardClicked"
                                   CommandParameter="{Binding .}" />

                            <!-- Delete button -->
                        <Button Grid.Column="2"
                                   Text="🗑️"
                                   FontSize="20"
                                   BackgroundColor="Transparent"
                                   Clicked="OnDeleteCardClicked"
                                   CommandParameter="{Binding .}" />
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <!-- Empty view -->
        <CollectionView.EmptyView>
            <StackLayout HorizontalOptions="Center"
                            VerticalOptions="Center">
                <Label Text="📚"
                           FontSize="60"
                           HorizontalOptions="Center" />
                <Label Text="Aucune carte"
                           FontSize="18"
                           TextColor="Gray"
                           HorizontalOptions="Center" 
                       x:Name="templs"/>
                <Label Text="Ajoutez votre première carte ci-dessus"
                           FontSize="14"
                           TextColor="LightGray"
                           HorizontalOptions="Center" />
            </StackLayout>
        </CollectionView.EmptyView>
    </CollectionView>
        <Label Grid.Row="2"
               x:Name="InfoLabel"
               Text="Prêt"
               FontSize="12"
               TextColor="Gray"
               HorizontalOptions="Center"
               Margin="0,10,0,0" />
    </Grid>
</ContentPage>