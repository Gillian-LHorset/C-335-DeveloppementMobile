<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="P_AppMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:P_AppMobile"
    xmlns:pages="clr-namespace:P_AppMobile.Resources.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="P_AppMobile">
    
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto, *, Auto" 
              HorizontalOptions="Fill" 
              Padding="10,0"
              HeightRequest="100"
              BackgroundColor="LightGray">

            <Label Grid.Column="1"
                   TextColor="Black"
                   FontAttributes="Bold"
                   VerticalOptions="Center" 
                   HorizontalOptions="Start" />

            <Image Grid.Column="2" 
                   Source="placeholder.jpg"
                   HorizontalOptions="End"
                   VerticalOptions="Center" 
                   HeightRequest="30" />
        </Grid>
    </Shell.TitleView>
    
    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="Accueil"
                      Route="home" 
                      ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent Title="Ouvrages" 
                      Route="Books" 
                      ContentTemplate="{DataTemplate pages:BooksPage}" />
    </FlyoutItem>
</Shell>
