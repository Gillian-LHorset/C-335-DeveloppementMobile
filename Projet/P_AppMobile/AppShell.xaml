<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="P_AppMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:P_AppMobile"
    Shell.FlyoutBehavior="Disabled"
    Title="P_AppMobile">

    <ShellContent
        Title=""
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Texte page"
        ContentTemplate="{DataTemplate local:NewTestPage}"
        Route="TestPage" />
    
</Shell>
